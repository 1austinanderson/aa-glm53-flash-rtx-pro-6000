FROM cstechdev/vllm:glm53-flash-nope-sm120-cu130-20260826-r1
# InstantTensor (local-inference-lab/voipmonitor fast safetensors loader) for the
# GLM-5.3-Flash serving image — 2026-08-28. PyPI wheel first, source build fallback.
ENV TORCH_CUDA_ARCH_LIST="12.0"
RUN pip install --no-cache-dir --no-build-isolation instanttensor \
 || (apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
     && pip install --no-cache-dir --no-build-isolation "git+https://github.com/voipmonitor/InstantTensor.git")
RUN python3 -c "import instanttensor, sys; print('instanttensor', getattr(instanttensor, '__version__', '?'))"
