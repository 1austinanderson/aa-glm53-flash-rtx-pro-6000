+def _glm5_next_sw_block_size(
+    sw_spec: SlidingWindowSpec, mla_page: int, mla_block: int
+) -> int:
+    """Block size for a draft model's sliding-window layers under the
+    GLM-5-Next layout.
+
+    Two hard constraints, both about *sharing a block id space* with the
+    MLA/mamba slot tensors:
+
+    1. The SW page must fit the MLA page (it is padded up to it and read
+       through the runner's strided view), so ``block * bytes_per_token
+       <= mla_page``.
+    2. ``resolve_kv_cache_block_sizes`` takes the LCM of every group's
+       block size as the scheduler's token-alignment invariant, and the
+       GCD as the prefix-cache hash granularity. A block size that is not
+       a divisor of the MLA block explodes the LCM (e.g. 3584 vs 1136 ->
+       254,464 tokens, larger than max_model_len) and collapses the GCD to
+       16. So take the largest *divisor* of the MLA block that fits, and
+       keep it a multiple of 16 for the kernels.
+
+    Returns 0 if no such block size exists.
+    """
+    per_token = sw_spec.real_page_size_bytes // sw_spec.block_size
+    if per_token <= 0:
+        return 0
+    limit = min(mla_block, mla_page // per_token)
+    for cand in range(limit // 16 * 16, 0, -16):
+        if mla_block % cand == 0:
+            return cand
+    return 0
+
+
