+def _dequant_mxfp8(weight_fp8: torch.Tensor, scale_e8m0: torch.Tensor) -> torch.Tensor:
+    """Dequantize an MXFP8 weight ([N, K] e4m3 + [N, K/32] e8m0-as-uint8) to BF16."""
+    n, k = weight_fp8.shape
+    group = k // scale_e8m0.shape[1]
+    scale = torch.exp2(scale_e8m0.to(torch.float32) - 127.0)
+    scale = scale.repeat_interleave(group, dim=1)[:, :k]
+    return (weight_fp8.to(torch.float32) * scale).to(torch.bfloat16).contiguous()
+
